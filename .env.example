# ===================================================
# LectureLens Environment Configuration
# Copy this file to '.env' and fill in your Gemini API key.
# NEVER commit your actual '.env' file to source control.
# ===================================================

# Google Gemini API Key (Required for AI generation & transcription)
# Obtain your key for free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Configurable defaults)
# Free-tier high-speed & stable models:
# - gemini-3.5-flash (recommended for notes generation)
# - gemini-3.5-transcribe (recommended for audio speech-to-text)
GEMINI_NOTES_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=change_this_to_a_random_secure_key_for_production
PORT=5000

# Security & Upload Limits
# Maximum upload size in Megabytes (default: 30MB for audio files)
MAX_UPLOAD_SIZE_MB=30
